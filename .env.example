# Token from @BotFather. Used by: tg-archive run
BOT_TOKEN=

# From https://my.telegram.org → API development tools.
# On the create-app form, choose the Desktop platform.
# Used by: tg-archive login, tg-archive chats, tg-archive history
API_ID=
API_HASH=

# Optional. International format, so login does not ask for it.
# TELEGRAM_PHONE=+15551234567

# Where chats are written. This folder is gitignored.
DATA_DIR=data

# Live capture (tg-archive run) downloads these unless you pass --no-images or --no-files.
# History ignores these and downloads media only when you pass --images and/or --files.
DOWNLOAD_IMAGES=true
DOWNLOAD_FILES=true

# Empty means every chat this bot or account can see.
# Or a comma-separated list of chat ids, for example: -100123,-100456
ALLOWED_CHAT_IDS=

# Leave this commented unless you run your own telegram-bot-api server.
# The hosted bot API downloads files up to 20 MB. A local server removes that cap.
# BOT_API_BASE=https://api.telegram.org
